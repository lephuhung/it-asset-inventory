#!/usr/bin/env bash
# ============================================================================
# install.sh — Cài OrgInventory Agent trên Linux (Ubuntu/Debian + RHEL/Rocky).
# Rendered dynamically bởi server từ token trong URL — KHÔNG cần arg dòng lệnh.
#
# Cách dùng (1 lệnh từ user):
#   curl -fsSL {{ portal_url }}/i/{{ token }} | sudo bash
#
# Flow:
#   1. Phát hiện distro + architecture
#   2. Tải binary self-contained OrgInventoryAgent (single-file .NET 8) + SHA256
#   3. Tạo user/group orginventory, thư mục data/log/run
#   4. Cài binary + helper, tạo systemd service (orginventory-agent + helper socket)
#   5. Ghi /etc/orginventory/config.json với token + endpoints
#   6. Enable + start services
# ============================================================================
set -euo pipefail

TOKEN="{{ token }}"
PORTAL_URL="{{ portal_url }}"
AGENT_SERVER_URL="{{ agent_server_url }}"
DATA_DIR="/var/lib/orginventory"

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
CYAN=$'\033[0;36m'
NC=$'\033[0m'

log_step()  { echo -e "${CYAN}[*] $1${NC}"; }
log_ok()    { echo -e "  ${GREEN}[OK]${NC} $1"; }
log_fail()  { echo -e "  ${RED}[FAIL]${NC} $1"; }
log_warn()  { echo -e "  ${YELLOW}[WARN]${NC} $1"; }

# ── 1. Privilege check ───────────────────────────────────────────────────
if [[ $EUID -ne 0 ]]; then
    log_fail "Cần quyền root. Chạy lại: curl -fsSL $PORTAL_URL/i/$TOKEN | sudo bash"
    exit 1
fi

# ── 2. Detect distro + architecture ───────────────────────────────────────
. /etc/os-release 2>/dev/null || { log_fail "Không đọc được /etc/os-release"; exit 1; }
ARCH="$(uname -m)"
case "$ARCH" in
    x86_64)  RID="linux-x64" ;;
    aarch64) RID="linux-arm64" ;;
    *) log_fail "Kiến trúc không hỗ trợ: $ARCH"; exit 1 ;;
esac

# ── 3. Tải binary self-contained + SHA256 ───────────────────────────────
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

BINARY_URL="$PORTAL_URL/download/agent-$RID"
BINARY_PATH="/opt/orginventory/OrgInventoryAgent"
HELPER_PATH="/opt/orginventory/orginventory-helper"

log_step "Phát hiện: $ID $VERSION_ID ($ARCH)"
log_step "Tải binary từ $BINARY_URL ..."

if ! curl -fsSL --max-time 120 -o "$TMP/OrgInventoryAgent" "$BINARY_URL"; then
    log_fail "Không tải được binary. Kiểm tra URL và token."
    exit 1
fi
chmod 0755 "$TMP/OrgInventoryAgent"
log_ok "Đã tải $(du -h "$TMP/OrgInventoryAgent" | cut -f1)"

# Tải helper (cùng binary — chỉ đổi tên)
cp "$TMP/OrgInventoryAgent" "$TMP/orginventory-helper"
chmod 0755 "$TMP/orginventory-helper"

# ── 4. Tạo user/group + thư mục ────────────────────────────────────────
log_step "Tạo user orginventory và thư mục..."

if ! getent group orginventory >/dev/null; then
    groupadd --system orginventory
fi
if ! getent passwd orginventory >/dev/null; then
    useradd --system --no-create-home --home "$DATA_DIR" --gid orginventory orginventory
fi

mkdir -p "$DATA_DIR" /var/log/orginventory /etc/orginventory /run/orginventory
chown -R orginventory:orginventory "$DATA_DIR" /var/log/orginventory /run/orginventory
chmod 0750 "$DATA_DIR" /var/log/orginventory /run/orginventory
chmod 0755 /etc/orginventory

# ── 5. Cài binary + helper ─────────────────────────────────────────────
log_step "Cài binary vào /opt/orginventory..."
mkdir -p /opt/orginventory
install -m 0755 "$TMP/OrgInventoryAgent" "$BINARY_PATH"
install -m 0755 "$TMP/orginventory-helper" "$HELPER_PATH"
log_ok "Đã cài binary + helper"

# ── 6. systemd units ────────────────────────────────────────────────────
log_step "Cài systemd service..."

cat > /etc/systemd/system/orginventory-agent.service <<'EOF'
[Unit]
Description=OrgInventory Agent (IT Asset Inventory)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orginventory
Group=orginventory
ExecStart=/opt/orginventory/OrgInventoryAgent --data-dir /var/lib/orginventory --config /etc/orginventory/config.json
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ProtectHome=yes
RestrictSUIDSGID=yes
# MemoryDenyWriteExecute=yes TẮT: .NET 8 cần JIT (ghi memory rồi thực thi) — chặn sẽ SEGV.
MemoryDenyWriteExecute=no
ReadWritePaths=/var/lib/orginventory /var/log/orginventory /run/orginventory

[Install]
WantedBy=multi-user.target
EOF

cat > /etc/systemd/system/orginventory-helper.socket <<'EOF'
[Unit]
Description=OrgInventory Helper (privileged operations socket)
Before=orginventory-agent.service

[Socket]
ListenStream=/run/orginventory/helper.sock
SocketMode=0660
SocketUser=root
SocketGroup=orginventory
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
EOF

cat > /etc/systemd/system/orginventory-helper.service <<'EOF'
[Unit]
Description=OrgInventory Helper (privileged operations)
After=orginventory-helper.socket

[Service]
Type=simple
User=root
ExecStart=/opt/orginventory/orginventory-helper
StandardInput=socket
StandardOutput=socket
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now orginventory-helper.socket
log_ok "Đã cài systemd units + enable helper socket"

# ── 7. Ghi /etc/orginventory/config.json ─────────────────────────────────
log_step "Ghi /etc/orginventory/config.json..."
cat > /etc/orginventory/config.json <<EOF
{
  "endpoints": ["$AGENT_SERVER_URL"],
  "enroll_token": "$TOKEN",
  "data_dir": "$DATA_DIR"
}
EOF
chmod 0640 /etc/orginventory/config.json
chown root:orginventory /etc/orginventory/config.json
log_ok "Đã ghi config.json"

# ── 8. Enable + start service chính ──────────────────────────────────────
log_step "Enable + start orginventory-agent.service..."
systemctl enable orginventory-agent.service
if systemctl start orginventory-agent.service; then
    sleep 2
    if systemctl is-active --quiet orginventory-agent.service; then
        log_ok "Service orginventory-agent đang chạy"
    else
        log_warn "Service start fail — xem: journalctl -u orginventory-agent -n 50"
    fi
else
    log_warn "systemctl start fail — xem: journalctl -u orginventory-agent -n 50"
fi

# ── 9. Verify helper socket ─────────────────────────────────────────────
if [[ -S /run/orginventory/helper.sock ]]; then
    log_ok "Helper socket /run/orginventory/helper.sock đã sẵn sàng"
fi

echo
echo "============================================================"
log_ok "Cài đặt thành công!"
echo "============================================================"
echo
echo "Agent sẽ tự enroll với $AGENT_SERVER_URL trong vòng 1 chu kỳ heartbeat (~30s)."
echo "Sau ~30s, máy sẽ hiển thị 'online' trên Portal."
echo
echo "Kiểm tra:"
echo "  • Log:    tail -f $DATA_DIR/logs/agent.log  (hoặc journalctl -u orginventory-agent -f)"
echo "  • Status: systemctl status orginventory-agent.service"
echo "  • Helper: ls -la /run/orginventory/helper.sock"