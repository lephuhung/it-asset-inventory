*.msi
*.zip
*.deb
*.rpm

# ── Chứng chỉ / private key (TUYỆT ĐỐI KHÔNG commit) ──
velociraptor-certs/
*.pem
*.key
*.yaml
*.yml

# ── Thư mục build tạm ──
build/
velociraptor-config-only/
publish/

# ── Binary agent Linux (build tự động khi build Docker) ──
OrgInventoryAgent-linux-*
orginventory-helper-linux-*
OrgInventoryAgent-linux-x64
