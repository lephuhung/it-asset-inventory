# ════════════════════════════════════════════════════════════════
# Server DEV image — FastAPI + uvicorn --reload
# Mount ./server từ host → sửa code reload ngay, không rebuild.
# Image chỉ chứa Python deps + system tools.
# ════════════════════════════════════════════════════════════════
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# System deps cho 1 số wheel (psycopg, bcrypt…), curl (healthcheck) và native libs cho WeasyPrint
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc libpq-dev curl \
        libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b libgdk-pixbuf-2.0-0 \
        shared-mime-info fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# Đầy đủ Python deps (đồng bộ với pyproject.toml)
COPY pyproject.toml ./
RUN pip install --no-cache-dir \
        "fastapi>=0.115.0" \
        "uvicorn[standard]>=0.30.0" \
        "pydantic>=2.7.0" \
        "pydantic-settings>=2.3.0" \
        "email-validator>=2.0.0" \
        "sqlalchemy[asyncio]>=2.0.30" \
        "asyncpg>=0.29.0" \
        "alembic>=1.13.0" \
        "redis>=5.0.0" \
        "pyjwt>=2.8.0" \
        "bcrypt>=4.1.0" \
        "cryptography>=42.0.0" \
        "pyotp>=2.9.0" \
        "jinja2>=3.1.0" \
        "slowapi>=0.1.9" \
        "httpx>=0.27.0" \
        "openpyxl>=3.1.0" \
        "weasyprint>=62.0" \
        "pyyaml>=6.0.0" \
        "docker>=7.0.0" \
        "python-multipart>=0.0.20" \
        # gRPC/VQL cho tích hợp Velociraptor DFIR (kết nối api_client.yaml / mTLS)
        "grpcio>=1.66.0" \
        "pyvelociraptor>=0.1.11" \
        # dev / reload tiện ích
        "watchfiles>=0.21.0"

EXPOSE 8000

# Default CMD — compose sẽ override thêm --reload
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
