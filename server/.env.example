# ── Môi trường ────────────────────────────────────────────────
APP_ENV=dev                    # dev | test | prod
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ── Cơ sở dữ liệu ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://inventory:inventory@localhost:5432/inventory
DB_ECHO=false

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6381/0
# online_ttl: để trống → tự tính = 2 × (HEARTBEAT_INTERVAL_SECONDS + HEARTBEAT_JITTER_SECONDS)
# ONLINE_TTL_SECONDS=180

# ── Agent heartbeat / inventory ────────────────────────────────
# Server điều chỉnh; agent đồng bộ qua /api/agent/config + heartbeat response.
# Agent gửi heartbeat ngẫu nhiên trong [interval-jitter, interval+jitter] (tránh beaconing).
# v1.2: mặc định 30s ± 8s (≈22–38s) — cập nhật online/offline nhanh hơn.
HEARTBEAT_INTERVAL_SECONDS=30
HEARTBEAT_JITTER_SECONDS=8
INVENTORY_INTERVAL_HOURS=24
# URL công khai agent liên hệ cho kênh mTLS (nginx agent block); khác PORTAL_URL
AGENT_SERVER_URL=https://agent.example.gov.vn

# ── JWT ───────────────────────────────────────────────────────
# ⚠️ Sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CA nội bộ (mTLS) ──────────────────────────────────────────
# CA_MODE=stepca  → gọi step-ca HTTP API (prod)
# CA_MODE=local   → sinh cert self-signed cục bộ (chỉ dùng dev/test)
CA_MODE=local
STEP_CA_URL=https://ca.internal:8443
STEP_CA_PROVISIONER=admin
STEP_CA_PROVISIONER_PASSWORD=CHANGE_ME
CLIENT_CERT_VALID_DAYS=365

# ── Bảo mật dữ liệu nhạy cảm ──────────────────────────────────
# ⚠️ Trong prod phải lấy từ Vault/KMS. Sinh: python -c "import secrets; print(secrets.token_hex(32))"
DATA_ENCRYPTION_KEY=CHANGE_ME_32_byte_hex_key_00000000000000

# ── Admin seed (chỉ chạy lúc khởi tạo) ────────────────────────
SEED_ADMIN_EMAIL=admin@example.gov.vn
SEED_ADMIN_PASSWORD=ChangeMe!123
SEED_ADMIN_FULL_NAME=Quản trị viên hệ thống

# ── Rate limit ────────────────────────────────────────────────
RATE_LIMIT_ENROLL=30/minute
RATE_LIMIT_LOGIN=10/minute

# ── Portal ────────────────────────────────────────────────────
PORTAL_URL=https://inventory.example.gov.vn
CORS_ORIGINS=["http://localhost:5173"]

# ── Velociraptor (DFIR — Digital Forensics & Incident Response) ─────────────
# Tích hợp Velociraptor Server (https://github.com/velocidex/velociraptor).
# Backend tự động sync hostname ↔ client_id mỗi SYNC_INTERVAL_SECONDS,
# không phụ thuộc Docker. Admin tải api_client.yaml + cấu hình GUI URL + Allowlist
# trên portal (/dfir/settings) — chỗ này chỉ là giá trị gợi ý ban đầu.
#
# - ENABLE=true: bật background sync + cho phép admin chạy hunt/collect
# - DEFAULT_URL: Velociraptor GUI/API URL (vd https://veloci.example.gov.vn:8889)
# - SYNC_INTERVAL_SECONDS=300: 5 phút/lần (đủ nhanh để bắt kịp máy mới enroll)
# - API_TIMEOUT_SECONDS=30: timeout mỗi request sang Velociraptor
# - DEFAULT_ALLOWLIST: JSON list artifact cho phép chạy (chống lạm quyền).
#   Mặc định gồm artifact read-only cho Windows + Linux + macOS (gồm
#   Windows.Forensics.Prefetch và Linux.* cho tính năng Top 10 sự kiện DFIR);
#   admin chỉnh trên portal nếu cần.
VELOCIRAPTOR_ENABLED=false
VELOCIRAPTOR_DEFAULT_URL=https://velociraptor.example.gov.vn:8889
VELOCIRAPTOR_SYNC_INTERVAL_SECONDS=300
VELOCIRAPTOR_API_TIMEOUT_SECONDS=30
VELOCIRAPTOR_DEFAULT_ALLOWLIST=["Generic.Client.Info","Windows.System.Services","Windows.System.Pslist","Windows.Network.Netstat","Windows.Network.NetstatEnriched","Windows.Network.Listeners","Windows.Forensics.Prefetch","Windows.EventLogs.Reboot","Windows.EventLogs.LogFile","Windows.ScheduledTasks.Catalog","Windows.StartupItems.Persist","Windows.Registry.Recursive","Windows.Registry.System","Windows.Registry.User","Linux.Sys.Pslist","Linux.Network.NetstatEnriched","Linux.Sys.LastUserLogin","MacOS.Sys.Pslist","MacOS.Network.Netstat"]

# ── LLM (DFIR AI Assistant) ─────────────────────────────────────
# Tích hợp Model LLM (Ollama / OpenAI / Qwen / vLLM) để phân tích log Velociraptor.
# Mặc định dùng Ollama local — dữ liệu điều tra KHÔNG rời máy (privacy-first).
# Khi muốn dùng cloud (OpenAI/Qwen), đổi base_url + điền api_key trên portal.
#
# - ENABLED: bật toàn bộ tính năng
# - DEFAULT_PROVIDER: ollama|openai|localai|vllm|custom
# - DEFAULT_BASE_URL: OpenAI-compatible endpoint
# - DEFAULT_MODEL: tên model đã pull sẵn
# - API_TIMEOUT_SECONDS=180: LLaMA-14B có thể chậm ~30-60s cho 4K output
# - MAX_CONTEXT_CHARS=200000: giới hạn log đưa vào 1 prompt
# - INVESTIGATION_INTERVAL_SECONDS=30: background worker poll job
LLM_ENABLED=false
LLM_DEFAULT_PROVIDER=ollama
LLM_DEFAULT_BASE_URL=http://127.0.0.1:11434/v1
LLM_DEFAULT_MODEL=qwen2.5:14b-instruct-q4_K_M
LLM_API_TIMEOUT_SECONDS=180
LLM_MAX_CONTEXT_CHARS=200000
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0
LLM_DAILY_TOKEN_BUDGET=
LLM_INVESTIGATION_INTERVAL_SECONDS=30
LLM_COLLECT_POLL_SECONDS=10
LLM_COLLECT_MAX_WAIT_SECONDS=600
LLM_DEFAULT_ARTIFACTS=["Windows.System.Pslist","Windows.System.Services","Windows.Network.Netstat","Windows.Network.Listeners","Windows.EventLogs.LogFile","Windows.ScheduledTasks.Catalog","Windows.Persistence.PermanentWMIBackdoor","Windows.Persistence.PermanentRegistry","Windows.Forensics.Prefetch","Windows.Registry.Recursive"]

# ── DeepAgent LangGraph (Docker Compose nội bộ) ───────────────
# Compose dùng token này cho cả API và container deepagent. Đặt chuỗi ngẫu nhiên
# mạnh trước khi triển khai; không nhập hoặc hiển thị nó trên Portal.
DEEPAGENT_SERVICE_TOKEN=CHANGE_ME_deepagent_service_token
# Callback key từ DeepAgent → backend, có scope investigation:write.
DEEPAGENT_BACKEND_API_KEY=
DEEPAGENT_REQUEST_TIMEOUT_SECONDS=30
DEEPAGENT_DEFAULT_LOOKBACK_HOURS=24
