# HTTP API của DeepAgent
DEEPAGENT_HOST=0.0.0.0
DEEPAGENT_PORT=8090
DEEPAGENT_SERVICE_TOKEN=CHANGE_ME_service_token
DEEPAGENT_MAX_CONCURRENT_JOBS=2

# Backend IT Asset Inventory nhận callback kết quả
DEEPAGENT_BACKEND_URL=http://127.0.0.1:8000
DEEPAGENT_BACKEND_API_KEY=CHANGE_ME_investigation_write_api_key

# LLM OpenAI-compatible (Ollama, vLLM, OpenAI, Qwen...)
DEEPAGENT_LLM_BASE_URL=http://127.0.0.1:11434/v1
DEEPAGENT_LLM_API_KEY=ollama
DEEPAGENT_LLM_MODEL=qwen2.5:14b-instruct-q4_K_M
DEEPAGENT_LLM_TIMEOUT_SECONDS=180

# MCP Velociraptor chạy qua stdio.
# MCP_ARGS_JSON phải trỏ tới mcp_velociraptor_bridge.py của:
# https://github.com/lephuhung/mcp-velociraptor
DEEPAGENT_MCP_TRANSPORT=stdio
DEEPAGENT_MCP_COMMAND=/path/to/mcp-velociraptor/.venv/bin/python
DEEPAGENT_MCP_ARGS_JSON=["/path/to/mcp-velociraptor/mcp_velociraptor_bridge.py"]
DEEPAGENT_MCP_ENV_JSON={"VELOCIRAPTOR_API_CONFIG":"/path/to/api_client.yaml","ENABLE_DANGEROUS_TOOLS":"false"}
DEEPAGENT_VELOCIRAPTOR_ORG_ID=

# Giới hạn an toàn
DEEPAGENT_MAX_STEPS=8
DEEPAGENT_MAX_EVIDENCE_CHARS=120000
DEEPAGENT_MAX_TOOL_RESULT_CHARS=30000
