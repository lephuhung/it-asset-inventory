# ── Cấu hình portal ─────────────────────────────────────────────
# API backend (FastAPI). Route handlers phía server Next.js dùng biến này
# để proxy sang backend (BFF) — không lộ ra trình duyệt.
API_BASE=http://localhost:8000

# ── WebSocket realtime ──────────────────────────────────────────
# Mặc định: cùng origin với portal (`/api/ws`).
# Dev: backend chạy riêng ở cổng 8000 → trỏ thẳng WS endpoint của backend
# (PHẢI có path `/api/ws` vì đó là route của backend; thiếu path sẽ 404).
NEXT_PUBLIC_WS_BASE=ws://localhost:8000/api/ws