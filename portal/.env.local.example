# ── Cấu hình portal ─────────────────────────────────────────────
# API backend (FastAPI). Route handlers phía server Next.js dùng biến này
# để proxy sang backend (BFF) — không lộ ra trình duyệt.
API_BASE=http://localhost:8000

# ── WebSocket realtime ──────────────────────────────────────────
# ĐÃ TỰ ĐỘNG lấy URL từ `portal_url` trong /agent-config (cùng IP user đã
# cấu hình qua UI → /agent-config). KHÔNG CẦN set biến này.
# Chỉ set khi deploy đặc biệt (VD portal behind nginx, muốn bắt buộc 1 host):
# NEXT_PUBLIC_WS_BASE=ws://localhost:8000/api/ws