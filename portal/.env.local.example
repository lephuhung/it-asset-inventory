# ── Cấu hình portal ─────────────────────────────────────────────
# API backend (FastAPI). Route handlers phía server Next.js dùng biến này
# để proxy sang backend (BFF) — không lộ ra trình duyệt.
API_BASE=http://localhost:8000

# ── WebSocket realtime ──────────────────────────────────────────
# Mặc định: cùng origin với portal (`/api/ws`).
# Dev: backend chạy riêng ở cổng 8000 → set địa chỉ ws của backend:
NEXT_PUBLIC_WS_BASE=ws://localhost:8000