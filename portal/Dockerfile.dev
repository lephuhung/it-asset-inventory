# ════════════════════════════════════════════════════════════════
# Portal DEV image — Next.js dev server với HMR
# Mount ./portal từ host (read-only) → sửa code reload ngay, không rebuild.
# Image chỉ chứa deps (pnpm install 1 lần lúc build).
# ════════════════════════════════════════════════════════════════
FROM node:22-bookworm-slim

WORKDIR /app

# Bật pnpm (corepack có sẵn trong node 22+)
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

# Manifests — để `pnpm install` reproducible
COPY package.json pnpm-lock.yaml* ./

# Cài deps (frozen lockfile). node_modules + .next được mount qua volume để cache.
RUN pnpm install --frozen-lockfile || npm install

EXPOSE 3003

ENV NODE_ENV=development \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3003 \
    HOSTNAME=0.0.0.0 \
    # WATCHPACK_POLLING bật polling cho Docker Desktop / WSL2 / ổ mount chậm
    WATCHPACK_POLLING=true \
    CHOKIDAR_USEPOLLING=true

# Default CMD — compose override bằng "pnpm dev"
CMD ["pnpm", "dev"]
