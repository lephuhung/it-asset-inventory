# Environment cho dev (copied from .env.example). KHÔNG dùng giá trị này trong production.
POSTGRES_PASSWORD=inventory_dev_pw
STEP_CA_PASSWORD=stepdevpassword
APP_SECRET_KEY=dev-secret-change-me

# Cấu hình app server
DATABASE_URL=postgresql+asyncpg://inventory:inventory_dev_pw@postgres:5432/inventory
REDIS_URL=redis://redis:6379/0
STEP_CA_URL=http://step-ca:9000

# JWT
JWT_SECRET=dev-jwt-secret-change-me
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Token enroll
ENROLL_TOKEN_TTL_HOURS=72
ENROLL_TOKEN_ENTROPY_BITS=128

# Heartbeat mặc định (giây)
DEFAULT_HEARTBEAT_INTERVAL=30

# Mã hóa AES-256-GCM cho dữ liệu nhạy cảm
# APP_SECRET_KEY được dùng để dẫn xuất AES key trong dev (64 hex chars = 32 bytes)

# Bật vài debug
LOG_LEVEL=INFO
